# Copy to .env and fill in locally; .env is ignored by git.
# Typhoon OCR keys, one per team member running a shard of scripts/ocr_typhoon.py.
TYPHOON_OCR_API_KEY_A=
TYPHOON_OCR_API_KEY_B=

# LLM APIs for query rewriting / generation (src/ncdqa/llm, configs/llm/providers.yaml). Put the real keys only in .env.
# The provider file stores the NAME of these variables, never a key.
GLM_API_KEY=
GEMINI_API_KEY=
TYPHOON_API_KEY=
