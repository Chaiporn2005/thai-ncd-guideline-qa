# Credentials and local settings
.env
.env.*
!.env.example
*.pem
*.key

# Python / editors
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.idea/
.vscode/

# Local document processing and model caches
tmp/
# Each data subfolder has its own reviewed metadata allowlist.
# Source bodies, OCR and indexes remain excluded there.
models/
.cache/
*.pdf
*.png
*.jpg
*.jpeg
*.sqlite

# OS files
Thumbs.db
.DS_Store

# Review exports hold the personal values a reviewer chose to remove
data/page_tag_decisions_*.json

# Review exports in the data root are copied to data/manifests when applied
data/ocr_review_decisions_*.json

# Retrieval indexes and chunk files contain document text (Track B): local only
data/index/

# Real LLM provider list (keys are env var names, but the endpoints are the owner's): local only
configs/llm/providers.yaml

# Hand-off packages contain corpus text (Siriraj leaflets included): never tracked
data/handoff/
